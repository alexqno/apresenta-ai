{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "PresentationSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresentationSession"] }]
}
